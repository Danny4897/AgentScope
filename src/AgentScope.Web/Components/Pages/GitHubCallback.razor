@page "/auth/github"
@layout AuthLayout
@inject NavigationManager Nav
@inject JwtAuthStateProvider AuthProvider
@inject IJSRuntime JS

<MudPaper Elevation="0" Style="background:#111827; border:1px solid #1F2937; border-radius:12px; padding:32px; text-align:center;">
    @if (_error != null)
    {
        <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Style="color:#EF4444; font-size:40px; margin-bottom:12px;" />
        <MudText Style="color:#EF4444; margin-bottom:16px;">@_error</MudText>
        <MudButton Href="/login" Variant="Variant.Outlined" Style="border-color:#374151; color:#9CA3AF;">
            Back to login
        </MudButton>
    }
    else
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
        <MudText Style="color:#6B7280; margin-top:16px;">Completing sign-in…</MudText>
    }
</MudPaper>

@code {
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var uri   = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var token = query["token"];
        var error = query["error"];

        if (!string.IsNullOrWhiteSpace(error))
        {
            _error = error switch
            {
                "github_not_configured" => "GitHub OAuth is not configured on the server.",
                "github_token_failed"   => "GitHub did not return a valid token.",
                _                       => "GitHub authentication failed. Please try again.",
            };
            StateHasChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(token))
        {
            _error = "No token received from GitHub.";
            StateHasChanged();
            return;
        }

        await AuthProvider.NotifyLoginAsync(token);
        Nav.NavigateTo("/");
    }
}
